{
  "name": "proofvault-midnight",
  "version": "1.0.0",
  "description": "Zero-Knowledge Selective-Disclosure Treasury Compliance & Confidential Invoice Settlement dApp on Midnight Network",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "vitest run tests/mutation-audit.test.ts",
    "verify:onchain": "node scripts/verify-onchain.mjs --network preview",
    "deploy:preview:dry": "node scripts/deploy-testnet.mjs --network preview --dry-run",
    "deploy:preview": "node scripts/deploy-testnet.mjs --network preview",
    "deploy:preprod": "node scripts/deploy-testnet.mjs --network preprod",
    "build:deck": "node scripts/build-deck.mjs",
    "compile:contract": "compact compile contracts/proofvault.compact contracts/managed/proofvault",
    "compile:contract:fast": "compact compile --skip-zk contracts/proofvault.compact contracts/managed/proofvault"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/dapp-connector-api": "4.1.0",
    "@noble/hashes": "^1.7.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fast-check": "^4.11.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
